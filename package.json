{
  "name": "hive-salon-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Hive Salon — Premium Centralized Multi-Branch Salon, Spa & Wellness ERP",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:server": "npm run --workspace=@hive/api-server dev",
    "dev:client": "npm run --workspace=@hive/web-client dev",
    "build": "turbo run build",
    "type-check": "turbo run type-check",
    "seed": "npm run --workspace=@hive/api-server seed",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "rimraf": "^6.0.1"
  },
  "allowScripts": {},
  "packageManager": "npm@10.9.2"
}
